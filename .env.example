# Local-only configuration: copy this file to .env and replace placeholders.
# No key or password in this file is usable. Do not commit your .env.
OPENAI_BASE_URL=https://your-provider.example/v1
OPENAI_API_KEY=replace-with-your-api-key
LLM_DEFAULT_MODEL=replace-with-a-supported-text-model
VL_MODEL=replace-with-a-supported-vision-model
LLM_DEFAULT_TEMPERATURE=0.0

MINERU_BASE_URL=https://your-mineru-service.example/api/v4
MINERU_API_TOKEN=replace-with-your-mineru-token
MCP_DASHSCOPE_BASE_URL=https://your-search-mcp-service.example/mcp

MILVUS_URL=http://127.0.0.1:19530
CHUNKS_COLLECTION=kb_chunks
ENTITY_NAME_COLLECTION=kb_entity_names
ITEM_NAME_COLLECTION=kb_item_names
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB_NAME=rag_history
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=replace-with-your-access-key
MINIO_SECRET_KEY=replace-with-your-secret-key
MINIO_BUCKET_NAME=knowledge-base-files
MINIO_IMG_DIR=upload-images
MINIO_SECURE=False

# Prefer explicit local model directories; obtain weights separately.
BGE_M3_PATH=models/bge-m3
BGE_M3=BAAI/bge-m3
BGE_DEVICE=cpu
BGE_FP16=False
BGE_RERANKER_LARGE=models/bge-reranker-large
BGE_RERANKER_DEVICE=cpu
BGE_RERANKER_FP16=False

LOG_CONSOLE_ENABLE=True
LOG_CONSOLE_LEVEL=INFO
LOG_FILE_ENABLE=False
LOG_FILE_LEVEL=INFO
LOG_FILE_RETENTION=7 days
